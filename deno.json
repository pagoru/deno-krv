{
  "name": "@da/deno-krv",
  "version": "0.0.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "unstable": ["kv"],
  "tasks": {
    "start": "cd ./src/__custom && deno run -A --watch ./main.ts",
    "test": "deno test -A",
    "new:migration": "deno run -RW ./cli.ts new-migration --dir=src/migrations"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/ulid": "jsr:@std/ulid@^1.0.0"
  },
  "test": {
    "include": ["tests/"]
  }
}
