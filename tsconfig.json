{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2025",
    "esModuleInterop": true,
    "sourceMap": false,
    "noUnusedLocals": true,
    "lib": [
      "es2025",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ],
    "rootDir": "./src",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true
  }
}
